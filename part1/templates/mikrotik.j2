/interface bridge
add name=lo

/interface ethernet
{% for myInterface in interfaces %}
set [ find default-name={{ myInterface.name }} ] disabled=no comment="{{ myInterface.desc }}"
{% endfor %}

/ip address
{% for myInterface in interfaces %}
add address={{ myInterface.ip }} interface={{ myInterface.name }}
{% endfor %}
add address={{ loopback }} interface=lo

/routing ospf instance
set [ find default=yes ] router-id={{ ospf.router_id }}

/routing ospf area
add name=area{{ ospf.local_area }} area-id=0.0.0.{{ ospf.local_area }}

/routing ospf network
{% for myNetwork in ospf.networks %}
add network={{ myNetwork.network }} area={{ myNetwork.area_name }}
{% endfor %}