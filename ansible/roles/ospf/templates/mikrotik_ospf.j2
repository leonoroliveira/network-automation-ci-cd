/interface bridge add name=lo
{% for myInterface in interfaces %}
/interface ethernet set [ find default-name={{ myInterface.name }} ] disabled=no comment="{{ myInterface.desc }}"
{% endfor %}
{% for myInterface in interfaces %}
/ip address add address={{ myInterface.ip }} interface={{ myInterface.name }}
{% endfor %}
/ip address add address={{ loopback }} interface=lo
/routing ospf instance set [ find default=yes ] router-id={{ ospf.router_id }}
/routing ospf area add name=area{{ ospf.local_area }} area-id=0.0.0.{{ ospf.local_area }}
{% for myNetwork in ospf.networks %}
/routing ospf network add network={{ myNetwork.network }} area={{ myNetwork.area_name }}
{% endfor %}